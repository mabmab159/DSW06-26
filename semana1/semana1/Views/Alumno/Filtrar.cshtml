@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model IEnumerable<Alumno>

@{
    ViewData["Title"] = "Filtrar";
}

<h2>Filtro</h2>

<form asp-action="Filtrar" asp-controller="Alumno">
    <em>Nombre del Alumno: </em>
    @Html.TextBox("nombre","")
    <button>Filtrar</button>
</form>


<table class="table row">
    <tr>
        <th>
            Id
        </th>
        <th>
            Nombre
        </th>
        <th>
            Apellido
        </th>
        <th>
            Correo
        </th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
            <td>@Html.DisplayFor(modelItem => item.Correo)</td>
        </tr>
    }
</table>

<!--Agregar el metodo de paginacion-->
<div>
    @for (int i = 0; i < ViewBag.cantidadPaginas; i++)
    {
        <a asp-action="Filtrar" asp-route-pagina=@i asp-route-nombre=@ViewBag.Nombre
        >@(i + 1)</a>
    }
</div>

<div>
    @Html.ActionLink("Regresando al Menu", "Index")
</div>