@model Alumno

@{
    ViewData["Title"] = "Create";
}

<h2>Pagina Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div>
        <h1>Alumno</h1>
        <div>
            @Html.LabelForModel("Nombre")
            @Html.EditorFor(model => model.Nombre, new {htmlAttributes = new { @class = "form-control" } })
        </div>
        <div>
            @Html.LabelForModel("Apellido")
            @Html.EditorFor(model => model.Apellido)
        </div>
        <div>
            @Html.LabelForModel("Correo")
            @Html.EditorFor(model => model.Correo)
        </div>
    </div>
    @ViewBag.Mensaje
    <div>
        <input type="submit" value="Create"/>
    </div>
    <div>
        @Html.ActionLink("Index", "Index")
    </div>
}